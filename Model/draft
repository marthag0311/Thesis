def plot_histogram_with_confidence(data, lower_conf, upper_conf):
    fig = px.histogram(data, nbins=50, title="Histogram of Renewable Capacities with Confidence Intervals")

    fig.add_vline(x=lower_conf, line_width=2, line_dash='dash', line_color='red',
                  annotation_text=f"Lower Conf ({lower_conf})", annotation_position="bottom left")
    fig.add_vline(x=upper_conf, line_width=2, line_dash='dash', line_color='green',
                  annotation_text=f"Upper Conf ({upper_conf})", annotation_position="bottom right")

    fig.update_layout(
        xaxis_title="Renewable Capacity",
        yaxis_title="Frequency",
        bargap=0.2
    )
    
    fig.show()

